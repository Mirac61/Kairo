{
  "name": "kairo",
  "displayName": "Kairo",
  "description": "Kairo: Planen in der WebUI, Arbeiten in VSCodium.",
  "publisher": "kairo-local",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kairo",
          "title": "Kairo",
          "icon": "media/kairo.svg"
        }
      ]
    },
    "views": {
      "kairo": [
        {
          "id": "kairo.context",
          "name": "Kontext"
        }
      ]
    },
    "commands": [
      {
        "command": "kairo.refresh",
        "title": "Kairo: Aktualisieren",
        "icon": "$(refresh)"
      },
      {
        "command": "kairo.startTask",
        "title": "Kairo: Task starten",
        "icon": "$(play)"
      },
      {
        "command": "kairo.pauseTask",
        "title": "Kairo: Task pausieren",
        "icon": "$(debug-pause)"
      },
      {
        "command": "kairo.completeTask",
        "title": "Kairo: Task abschließen",
        "icon": "$(check)"
      },
      {
        "command": "kairo.openResource",
        "title": "Kairo: Ressource öffnen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kairo.refresh",
          "when": "view == kairo.context",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kairo.startTask",
          "when": "view == kairo.context && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "kairo.pauseTask",
          "when": "view == kairo.context && viewItem == task.running",
          "group": "inline@1"
        },
        {
          "command": "kairo.completeTask",
          "when": "view == kairo.context && viewItem =~ /^task/",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Kairo",
      "properties": {
        "kairo.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8742",
          "description": "Basis-URL des lokalen Kairo-Backends."
        },
        "kairo.idleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Nach so vielen Minuten ohne Aktivität in VSCodium fragt Kairo bei laufendem Timer, ob er pausiert werden soll (0 = aus). Kairo pausiert nie von selbst."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node out/core.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
