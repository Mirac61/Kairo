# Kopieren nach .env (nicht eingecheckt) und anpassen. Gelesen von make deploy / make deploy-notes.
PI=<benutzer>@<pi-host>
# Optional: Zielordner auf dem Pi (Standard /home/<benutzer>/kairo)
ZIEL=
# Optional: lokaler Vault für make deploy-notes (Standard notes_dir aus config.json, sonst ~/Kairo)
VAULT=
